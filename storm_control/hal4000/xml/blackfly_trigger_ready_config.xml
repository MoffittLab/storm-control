<?xml version="1.0" encoding="ISO-8859-1"?>
<config>

  <!--
      Example hardware timed setup with Blackfly cameras in 'TriggerWidth'
      exposure mode and a start trigger from the trigger ready logic.

      Wiring (the line / PFI choices are placeholders, change as needed):

      (1) Each camera's 'trigger_ready_line' outputs the camera's
          FrameTriggerWait signal to the trigger ready (RP2040) board.

      (2) The board's 1 kHz output, which is gated on all the cameras
          being ready, goes to the counter start trigger, /Dev1/PFI0.

      (3) The counter output, /Dev1/ctr0 (/Dev1/PFI12 on X-series boards),
          goes to every camera's 'trigger_source' line. The counter high
          time is the exposure time. This is also the 'camera_fire_pin'
          that clocks the illumination waveforms.
  -->

  <!-- The starting directory. -->
  <directory type="directory">C:\Data\Temp\</directory>

  <!-- The setup name -->
  <setup_name type="string">blackfly_trigger_ready</setup_name>

  <!-- The ui type, this is 'classic' or 'detached' -->
  <ui_type type="string">detached</ui_type>

  <strict type="boolean">True</strict>

  <modules>

    <hal>
      <class_name type="string">HalController</class_name>
      <module_name type="string">storm_control.hal4000.hal4000</module_name>
    </hal>

    <display>
      <class_name type="string">Display</class_name>
      <module_name type="string">storm_control.hal4000.display.display</module_name>
      <parameters>
	<colortable type="string">ramp.ctbl</colortable>
      </parameters>
    </display>

    <feeds>
      <class_name type="string">Feeds</class_name>
      <module_name type="string">storm_control.hal4000.feeds.feeds</module_name>
    </feeds>

    <film>
      <class_name type="string">Film</class_name>
      <module_name type="string">storm_control.hal4000.film.film</module_name>
      <parameters>
	<extension desc="Movie file name extension" type="string" values=",Red,Green,Blue"></extension>
      </parameters>
    </film>

    <mosaic>
      <class_name type="string">Mosaic</class_name>
      <module_name type="string">storm_control.hal4000.mosaic.mosaic</module_name>
      <parameters>
	<flip_horizontal desc="Flip image horizontal (mosaic)" type="boolean">False</flip_horizontal>
	<flip_vertical desc="Flip image vertical (mosaic)" type="boolean">False</flip_vertical>
	<transpose desc="Transpose image (mosaic)" type="boolean">False</transpose>
	<objective desc="Current objective" type="string" values="obj1">obj1</objective>
	<obj1 desc="Objective 1" type="custom">60x,0.120,0.0,0.0</obj1>
      </parameters>
    </mosaic>

    <settings>
      <class_name type="string">Settings</class_name>
      <module_name type="string">storm_control.hal4000.settings.settings</module_name>
    </settings>

    <!-- The time base is the hardware timing module. -->
    <timing>
      <class_name type="string">Timing</class_name>
      <module_name type="string">storm_control.hal4000.timing.timing</module_name>
      <parameters>
	<time_base type="string">hardware_timing</time_base>
      </parameters>
    </timing>

    <!-- All the cameras must be slaves in a hardware timed setup. -->
    <camera1>
      <class_name type="string">Camera</class_name>
      <module_name type="string">storm_control.hal4000.camera.camera</module_name>
      <camera>
	<master type="boolean">False</master>
	<class_name type="string">PointGreyCameraControl</class_name>
	<module_name type="string">storm_control.hal4000.camera.pointgreyCameraControl</module_name>
	<parameters>
	  <camera_id type="string">00000001</camera_id>

	  <presets>
	    <PixelFormat type="string">Mono16</PixelFormat>
	    <ExposureAuto type="string">Off</ExposureAuto>
	    <GainAuto type="string">Off</GainAuto>
	    <BlackLevelClampingEnable type="boolean">False</BlackLevelClampingEnable>
	  </presets>

	  <!-- Camera input line for the trigger, 'Line3' is the default. -->
	  <trigger_source type="string">Line3</trigger_source>

	  <!--
	      'Timed' (camera sets the exposure time) or 'TriggerWidth'
	      (the trigger pulse width sets the exposure time). If this
	      is 'TriggerWidth' 'trigger_activation' defaults to 'LevelHigh'.
	  -->
	  <exposure_mode type="string">TriggerWidth</exposure_mode>

	  <!--
	      Camera output line for the FrameTriggerWait (trigger ready)
	      signal.

	      Polarity: keep 'trigger_ready_invert' False and set the trigger
	      ready board's input to active-low. With the opto-isolated output
	      (Line1) and a pull-up on the board, the camera then pulls the line
	      LOW only while it is ready, so an unplugged or unconfigured camera
	      reads as NOT ready (fail-safe). Inverting here would make the
	      idle, pulled-up line read as ready.
	  -->
	  <trigger_ready_line type="string">Line1</trigger_ready_line>
	  <trigger_ready_invert type="boolean">False</trigger_ready_invert>

	  <default_max type="int">200</default_max>
	  <default_min type="int">30</default_min>
	  <flip_horizontal type="boolean">False</flip_horizontal>
	  <flip_vertical type="boolean">False</flip_vertical>
	  <transpose type="boolean">False</transpose>
	  <extension type="string">c1</extension>
	  <saved type="boolean">True</saved>
	</parameters>
      </camera>
    </camera1>

    <camera2>
      <class_name type="string">Camera</class_name>
      <module_name type="string">storm_control.hal4000.camera.camera</module_name>
      <camera>
	<master type="boolean">False</master>
	<class_name type="string">PointGreyCameraControl</class_name>
	<module_name type="string">storm_control.hal4000.camera.pointgreyCameraControl</module_name>
	<parameters>
	  <camera_id type="string">00000002</camera_id>

	  <presets>
	    <PixelFormat type="string">Mono16</PixelFormat>
	    <ExposureAuto type="string">Off</ExposureAuto>
	    <GainAuto type="string">Off</GainAuto>
	    <BlackLevelClampingEnable type="boolean">False</BlackLevelClampingEnable>
	  </presets>

	  <trigger_source type="string">Line3</trigger_source>
	  <exposure_mode type="string">TriggerWidth</exposure_mode>
	  <trigger_ready_line type="string">Line1</trigger_ready_line>
	  <trigger_ready_invert type="boolean">False</trigger_ready_invert>

	  <default_max type="int">200</default_max>
	  <default_min type="int">30</default_min>
	  <flip_horizontal type="boolean">False</flip_horizontal>
	  <flip_vertical type="boolean">False</flip_vertical>
	  <transpose type="boolean">False</transpose>
	  <extension type="string">c2</extension>
	  <saved type="boolean">True</saved>
	</parameters>
      </camera>
    </camera2>

    <daq>
      <module_name type="string">storm_control.sc_hardware.nationalInstruments.nidaqModule</module_name>
      <class_name type="string">NidaqModule</class_name>

      <configuration>
	<!--
	    The illumination waveforms are clocked by the camera fire pin, which
	    is the counter output, so they start when the exposure starts.
	-->
	<timing>
	  <camera_fire_pin type="string">/Dev1/PFI12</camera_fire_pin>
	  <counter type="string">/Dev1/ctr1</counter>
	  <counter_out type="string">/Dev1/PFI13</counter_out>
	</timing>

	<!--
	    This counter provides the hardware time base for the cameras. It
	    waits for the first rising edge of the gated 1 kHz signal from the
	    trigger ready board. 'retriggerable' must be False, otherwise every
	    burst of the 1 kHz signal between frames would restart the counter.

	    'trigger_filter' (seconds) is optional. It enables the DAQ's digital
	    filter on the trigger line, rejecting pulses shorter than this. The
	    trigger ready board already filters its inputs and always starts the
	    1 kHz signal with a full-width pulse, so it is normally not needed.
	    Enable it only if noise on the cable to the DAQ causes false starts.
	-->
	<counter>
	  <ctc_task>
	    <source type="string">/Dev1/ctr0</source>
	    <frequency type="float">10</frequency>
	    <trigger_source type="string">/Dev1/PFI0</trigger_source>
	    <trigger_edge type="string">rising</trigger_edge>
	    <retriggerable type="boolean">False</retriggerable>
	    <!-- <trigger_filter type="float">6.425e-6</trigger_filter> -->
	  </ctc_task>
	</counter>
      </configuration>
    </daq>

    <!--
	Hardware camera timing. The counter high time is 'exposure_time' and
	the low time is 1/fps - exposure_time, which must be at least
	'min_low_time' so that the cameras can re-arm. Remove 'exposure_time'
	to get the original 50% duty cycle behavior.
    -->
    <hardware_timing>
      <class_name type="string">HardwareTiming</class_name>
      <module_name type="string">storm_control.hal4000.timing.hardwareTiming</module_name>
      <configuration>
	<counter_fn_name>daq.counter.ctc_task</counter_fn_name>
	<fps type="float">10.0</fps>
	<fps_min type="float">0.1</fps_min>
	<fps_max type="float">200.0</fps_max>
	<exposure_time type="float">0.05</exposure_time>
	<exposure_time_min type="float">1.0e-5</exposure_time_min>
	<exposure_time_max type="float">10.0</exposure_time_max>
	<min_low_time type="float">0.001</min_low_time>

	<!-- Seconds to wait for the start trigger, 0 means wait forever. -->
	<start_timeout type="float">10.0</start_timeout>
      </configuration>
    </hardware_timing>

  </modules>
</config>
